-- clear
all id

all $ hurry 2

all $ hurry 4

all $ hurry 8

all $ hurry 16

all $ (hurry 0.3).(# room 0.3).(# sz 0.9).(sometimes (|+ n 24))

all (|+ coarse "9")

all $ (# djf 0.8)

all $ struct "t/1.3"

all $ (hurry 0.3).(ply (fast 5 "<1 10 100>")) --ahhhhhhhhh

all $ (hurry 0.3).(ply 5)

all $ slow "1 4 2 8 -2 4 -4 2"

all $ ply (slow 6 $ range 2 32 $ sine)

all $ ply "1 2 4 8 16 32 64 112 224"

all $ slow 1

all $ (# scram (fast 4 "<0.1 0 0.3 0 0.5 0 0.9 0>"))

all $ hurry 4 .(somecycles (struct "1(7,16)"))

all $ somecycles (struct "1(11,16)")

all $ swingBy 0.8 8

all $ (# room (fast 3 "<0 0.2 0.3 0.5 0.7 0.9>")) .(# size 0.7) .(# shape 0.2)

all $ (# room (fast 3 (range (-0.2) 0.9 $ slow 8 sine))) .(# size 0.7) .(# shape 0.2)

all (sometimesBy 0.3 (rev))

all (sometimesBy 0.3 (# crush 4))

all (often (|+| gain (range (-0.2) 0.2 $ slow 8 sine)))

all (# pan rand)

all (slow 0.5)

all (rev)

all (degradeBy 0.8)

all (jux rev)

all $ palindrome

all (often (|+| gain (rand)))

all (rarely (# speed 8))

all ((# shape 0.3).(# gain 0.9))

all ((# cut 1).(fast 4))

all (# lpf "1000 3000 6000 2000 20000 4000 300")

mute 1

unsoloAll

unmuteAll

muteAll

hush

do --panic and reset everything
panic
hush
unsoloAll
unmuteAll
all id
