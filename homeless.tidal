resetCycles --1

let runmod r m o = ((run r) |% m |+ o) --2

d15 --3
$ n (slow 2 $ runmod 8 5 "<0 2>/2") |+ n 1
# s "numbers"
# legato 1
# accelerate 2
# room "1.2 0.1 0 3" # sz "0.1@2 1.5@4" # lock 1


