d1 --sub
$ stack [
s "mybass1" # cut 1 # gain 0, --very subby no need
s "mybass2" # cut 2 # gain 1] -- listenable sub

d2 --riser
$ s "cyberriser" # cut 3 # legato 1 --slow ahh buildup


d3 --one shot bass
$ s "pjedbassdrop" # cut 4 # legato 1 --whynot

d4 --texture
$ stack [
s "candy" # cut 5 # gain 0,
s "grainbeep" # cut 6 # gain 0,
s "plastic" # cut 7 # gain 0,
s "wateronly" # cut 8 # gain 0,
s "marbles" # cut 9 # gain 0,
s "metawestcum" # cut 10 # gain 1]

d5 --foley
$ stack [
s "mud" # cut 11 # gain 0,
s "glassbreak" # cut 12 # gain 0,
s "cannonshot" # cut 13 # gain 1,
s "bomb" # cut 14 # gain 0]

d6 --ms
$ stack [
s "psytrance" # cut 15 # gain 0,
s "sdsong" # cut 16 # gain 0,
s "myambience" # cut 17 # gain 1 # room 0.8 # sz 0.9]

d7 --beat
$ stack [
s "verbbeat" # cut 19 # gain 0 # legato 1,
s "africandrum" # cut 20 # gain 1 # legato 0,
s "breakwater" # cut 21 # gain 0] --not so beat

d8 --voxvox
$ stack [
s "voxringmod" # cut 22 # gain 1,
s "voxspam" # cut 23 # gain 0,
s "voxspectral" # cut 24 # gain 0]

